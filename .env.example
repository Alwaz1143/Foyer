# ============================================================
# FOYER — Environment Variables Reference
# ============================================================
# This file documents every secret/config this project needs.
# It is safe to commit — no real values go here.
#
# NOTE: This project is vanilla HTML/JS (no bundler), so .env
# files are NOT auto-loaded. Runtime config lives in config.js
# (gitignored). Copy config.example.js → config.js to set up.
#
# For the Cloudflare Worker, copy cloudflare-worker/.dev.vars.example
# → cloudflare-worker/.dev.vars  (for local `wrangler dev`)
# Production Worker secrets are set via: wrangler secret put <NAME>
# ============================================================


# ── FIREBASE ─────────────────────────────────────────────────
# Source: Firebase Console → Project Settings → Your apps → Web app
# These are frontend keys — Firebase security comes from rules, not key secrecy.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=        # optional, used for Analytics


# ── UNSPLASH ──────────────────────────────────────────────────
# Source: https://unsplash.com/developers → Your App → Keys

UNSPLASH_ACCESS_KEY=            # Public "Access Key" — used for wallpaper API + OAuth client_id
UNSPLASH_SECRET_KEY=            # Private — stored ONLY in Cloudflare Worker secret, never in frontend


# ── CLOUDFLARE WORKER ─────────────────────────────────────────
# These are only needed if running the Worker locally with `wrangler dev`.
# For production, set via: wrangler secret put UNSPLASH_CLIENT_ID
#                           wrangler secret put UNSPLASH_CLIENT_SECRET
# See: cloudflare-worker/.dev.vars.example
