# Cloudflare Worker local development secrets
# Used by `wrangler dev` for local testing.
# NEVER commit this file — it's in .gitignore.
#
# Copy this file to .dev.vars and fill in your real values.
# For production, secrets are set via: wrangler secret put <NAME>

UNSPLASH_CLIENT_ID=YOUR_UNSPLASH_ACCESS_KEY
UNSPLASH_CLIENT_SECRET=YOUR_UNSPLASH_SECRET_KEY
